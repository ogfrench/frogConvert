{
  "mcpServers": {
    "frogconvert": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/frogconvert",
      "args": [
        "mcp"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "env": {
        "FROGCONVERT_DISABLE_BROWSER_BRIDGE": "1",
        "FROGCONVERT_DENY_OVERWRITE": "1"
      }
    }
  }
}
