{
  "name": "frogconvert",
  "productName": "frogConvert",
  "author": "ogfrench",
  "description": "Truly universal browser-based file converter and PDF editor",
  "version": "2.3.9",
  "homepage": "https://frogconvert.xyz",
  "repository": "https://github.com/ogfrench/frogConvert",
  "type": "module",
  "main": "src/electron.cjs",
  "bin": {
    "frogconvert": "bin/frogconvert.ts"
  },
  "files": [
    "bin/",
    "src/mcp/",
    "src/api/",
    "src/core/",
    "src/workers/",
    "src/handlers/",
    "src/tools/",
    "src/global.d.ts"
  ],
  "scripts": {
    "dev": "bun x vite",
    "mcp": "bun src/mcp/index.ts",
    "api": "bun src/api/index.ts",
    "build": "bun x tsc && bun x vite build",
    "test": "bun x vitest run",
    "test:watch": "bun x vitest",
    "cache:build": "bun run scripts/buildCache.js dist/cache.json --minify",
    "cache:build:dev": "bun run scripts/buildCache.js dist/cache.json",
    "preview": "bun x vite preview",
    "docker": "bun run docker:build && bun run docker:up",
    "docker:build": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml build --build-arg VITE_COMMIT_SHA=$(git rev-parse HEAD)",
    "docker:up": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml up -d",
    "desktop:build": "bun x tsc && IS_DESKTOP=true bun x vite build && bun run cache:build",
    "desktop:preview": "bun x electron .",
    "desktop:start": "bun run desktop:build && bun run desktop:preview",
    "desktop:dist:win": "bun run desktop:build && bun x electron-builder --win --publish never",
    "desktop:dist:mac": "bun run desktop:build && bun x electron-builder --mac --publish never",
    "desktop:dist:linux": "bun run desktop:build && bun x electron-builder --linux --publish never",
    "compile:win": "bun build --compile --target=bun-windows-x64 bin/frogconvert.ts --outfile=release/frogconvert-win.exe",
    "compile:mac": "bun build --compile --target=bun-darwin-arm64 bin/frogconvert.ts --outfile=release/frogconvert-mac-arm64",
    "compile:mac:x64": "bun build --compile --target=bun-darwin-x64 bin/frogconvert.ts --outfile=release/frogconvert-mac-x64",
    "compile:linux": "bun build --compile --target=bun-linux-x64 bin/frogconvert.ts --outfile=release/frogconvert-linux",
    "docs:verify": "bun run scripts/verify-docs.ts",
    "audit": "bun audit --level high",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.ogfrench.frogconvert",
    "icon": "public/icon-512.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/electron.cjs"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/meyda": "^5.3.0",
    "@types/opentype.js": "^1.3.9",
    "@types/pako": "^2.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/sortablejs": "^1.15.9",
    "@types/three": "^0.182.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "puppeteer": "^24.36.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@flo-audio/reflo": "^0.1.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@imagemagick/magick-wasm": "^0.0.37",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sqlite.org/sqlite-wasm": "^3.51.2-build6",
    "@stringsync/vexml": "^0.1.8",
    "@toon-format/toon": "^2.1.0",
    "@xmldom/xmldom": "^0.8.11",
    "bson": "^7.2.0",
    "celaria-formats": "^1.0.2",
    "chess.js": "^1.4.0",
    "dompurify": "^3.3.3",
    "ffmpeg-static": "^5.3.0",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.11.1",
    "imagetracer": "^0.2.2",
    "js-synthesizer": "^1.11.0",
    "json5": "^2.2.3",
    "jszip": "^3.10.1",
    "marked": "^17.0.4",
    "mermaid": "^11.13.0",
    "meyda": "^5.6.3",
    "mime": "^4.1.0",
    "nanotar": "^0.3.0",
    "nbtify": "^2.2.0",
    "opentype.js": "^1.3.4",
    "pako": "^2.1.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "pe-library": "^2.0.1",
    "sortablejs": "^1.15.7",
    "svg-pathdata": "^8.0.0",
    "three": "^0.182.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.9.8",
    "ts-flp": "^1.0.3",
    "turbowarp-packager-browser": "3.11.1",
    "upng-js": "^2.1.0",
    "verovio": "^6.0.1",
    "vexflow": "^5.0.0",
    "vite-plugin-static-copy": "^3.1.6",
    "wavefile": "^11.0.0",
    "woff2-encoder": "^2.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.8.2"
  }
}
